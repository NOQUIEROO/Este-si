# Token del bot de ODD, que te da @BotFather. Tiene que ser DISTINTO al del
# otro bot del repo: son dos bots de Telegram separados.
BOT_TOKEN=123456:ABC-DEF...

# Los ids de Telegram de los admins (te lo dice @userinfobot), separados por
# coma. Los admins son los unicos que dan de alta bares, numeran placas y leen
# reflexiones. Aca van vos y Andy.
ADMIN_IDS=

# Donde vive la base y los respaldos. En Docker mapealo a un volumen.
DATA_DIR=./data-odd

# Sal secreta para el HMAC de los anfitriones.
# Si la dejas vacia se genera sola en DATA_DIR/.salt la primera vez.
SECRET_SALT=

# El trato: cuanto se invita por reflexion, y en que moneda se muestra.
CREDITO=3
MONEDA=USD

# Radio inicial de busqueda, en metros, y cuantos bares mostrar.
SCAN_RADIUS_M=2500
SCAN_LIMIT=6

# Respaldos automaticos: cada cuantas horas y cuantos archivos conservar.
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=48

# Muy recomendado: id de un chat al que el bot manda cada respaldo como
# archivo. Aca hay contactos de gente adentro: si el disco muere, se pierden.
BACKUP_CHAT_ID=
