# Token que te da @BotFather. Lo unico obligatorio.
BOT_TOKEN=123456:ABC-DEF...

# Tu user id numerico de Telegram (te lo dice @userinfobot).
# Los admins son los unicos que pueden generar codigos de invitacion.
# Podes poner varios separados por coma.
ADMIN_IDS=

# Donde vive la base y los respaldos. En Docker mapealo a un volumen.
DATA_DIR=./data

# Sal secreta para el HMAC de los miembros.
# Si la dejas vacia se genera sola en DATA_DIR/.salt la primera vez.
# GUARDALA: si la perdes, todos tienen que volver a canjear un codigo.
SECRET_SALT=

# Radio inicial del escaneo, en metros, y cuantos resultados mostrar.
SCAN_RADIUS_M=3000
SCAN_LIMIT=5

# Respaldos automaticos: cada cuantas horas y cuantos archivos conservar.
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=48

# Opcional pero muy recomendado: id de un chat (o tu propio user id) al que
# el bot manda cada respaldo como archivo. Es el respaldo fuera del servidor:
# si el disco se muere, la base sigue viva en Telegram.
BACKUP_CHAT_ID=
